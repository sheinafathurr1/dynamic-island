<Window x:Class="DynamicIsland.IslandWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:DynamicIsland.Controls"
        Title="Dynamic Island"
        Width="480" Height="230"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" ShowActivated="False" Topmost="True"
        FontFamily="{StaticResource UiFont}" Foreground="{StaticResource PrimaryText}">

    <!-- The window is a fixed transparent canvas; fully transparent pixels are click-through,
         so only the black island itself ever receives the mouse. -->
    <Grid x:Name="Root" Opacity="0">
        <StackPanel x:Name="Shape" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Top"
                    Margin="0,8,0,0"
                    MouseEnter="Shape_MouseEnter" MouseLeave="Shape_MouseLeave"
                    MouseLeftButtonUp="Shape_MouseLeftButtonUp" MouseDown="Shape_MouseDown"
                    AllowDrop="True" DragEnter="Shape_DragOver" DragOver="Shape_DragOver"
                    DragLeave="Shape_DragLeave" Drop="Shape_Drop">
            <StackPanel.ContextMenu>
                <ContextMenu Opened="Menu_Opened">
                    <MenuItem Header="Dynamic Island" IsEnabled="False" />
                    <Separator />
                    <MenuItem Header="Timer">
                        <MenuItem Header="1 menit" Tag="1" Click="TimerPreset_Click" />
                        <MenuItem Header="5 menit" Tag="5" Click="TimerPreset_Click" />
                        <MenuItem Header="10 menit" Tag="10" Click="TimerPreset_Click" />
                        <MenuItem Header="15 menit" Tag="15" Click="TimerPreset_Click" />
                        <MenuItem Header="25 menit (Pomodoro)" Tag="25" Click="TimerPreset_Click" />
                        <MenuItem Header="45 menit" Tag="45" Click="TimerPreset_Click" />
                        <MenuItem Header="60 menit" Tag="60" Click="TimerPreset_Click" />
                        <Separator />
                        <MenuItem x:Name="MenuTimerStop" Header="Hentikan timer" Click="TimerStop_Click" />
                    </MenuItem>
                    <Separator />
                    <MenuItem x:Name="MenuIsland" Header="Gaya island (melayang)" Click="MenuIsland_Click" />
                    <MenuItem x:Name="MenuNotch" Header="Gaya notch (menempel di atas)" Click="MenuNotch_Click" />
                    <Separator />
                    <MenuItem Header="Notifikasi">
                        <MenuItem x:Name="MenuVolume" Header="Perubahan volume" Click="MenuVolume_Click" />
                        <MenuItem x:Name="MenuTracks" Header="Lagu baru" Click="MenuTracks_Click" />
                        <MenuItem x:Name="MenuDevices" Header="Ganti perangkat audio" Click="MenuDevices_Click" />
                        <MenuItem x:Name="MenuPrivacy" Header="Mikrofon &amp; kamera aktif" Click="MenuPrivacy_Click" />
                    </MenuItem>
                    <MenuItem Header="Lirik">
                        <MenuItem x:Name="MenuLyrics" Header="Tampilkan lirik (lrclib.net)" Click="MenuLyrics_Click" />
                        <MenuItem x:Name="MenuCompactLyrics" Header="Lirik di island ringkas" Click="MenuCompactLyrics_Click" />
                    </MenuItem>
                    <MenuItem x:Name="MenuStartup" Header="Jalankan saat Windows mulai" Click="MenuStartup_Click" />
                    <Separator />
                    <MenuItem Header="Keluar" Click="MenuExit_Click" />
                </ContextMenu>
            </StackPanel.ContextMenu>

            <Path x:Name="ShoulderLeft" Data="{StaticResource NotchShoulder}" Fill="{StaticResource IslandBrush}"
                  VerticalAlignment="Top" Margin="0,0,-1,0" Visibility="Collapsed" />

            <Border x:Name="Island" Background="{StaticResource IslandBrush}" VerticalAlignment="Top"
                    Width="120" Height="32" CornerRadius="16">
                <Grid x:Name="Stage">

                    <!-- Idle: empty pill, plus the mic / camera dots when they are in use -->
                    <Grid x:Name="IdleView" VerticalAlignment="Top" Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0">
                            <StackPanel x:Name="IdleShelfBadge" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,5,0"
                                        Background="Transparent" Cursor="Hand" Visibility="Collapsed"
                                        MouseLeftButtonUp="ShelfBadge_MouseLeftButtonUp">
                                <Viewbox Width="12" Height="12" VerticalAlignment="Center">
                                    <Grid Width="16" Height="16">
                                        <Path Data="{StaticResource IconTray}" Style="{StaticResource StrokeIcon}" StrokeThickness="1.7"
                                              StrokeLineJoin="Round" Stroke="{StaticResource SecondaryText}" />
                                    </Grid>
                                </Viewbox>
                                <TextBlock x:Name="IdleShelfCount" FontSize="11" FontWeight="SemiBold" Margin="4,0,0,0"
                                           VerticalAlignment="Center" Foreground="{StaticResource SecondaryText}" />
                            </StackPanel>
                            <Ellipse x:Name="IdleMicDot" Width="6" Height="6" Margin="3,0" Fill="{StaticResource MicBrush}" Visibility="Collapsed" />
                            <Ellipse x:Name="IdleCameraDot" Width="6" Height="6" Margin="3,0" Fill="{StaticResource CameraBrush}" Visibility="Collapsed" />
                        </StackPanel>
                    </Grid>

                    <!-- Compact: left slot = artwork or timer ring, right slot = equalizer and/or countdown -->
                    <Grid x:Name="CompactView" VerticalAlignment="Top" Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid HorizontalAlignment="Left" VerticalAlignment="Center" Margin="5,0,0,0">
                            <Border x:Name="CompactArt" Style="{StaticResource Artwork}" Width="22" Height="22" CornerRadius="6">
                                <TextBlock Style="{StaticResource ArtworkGlyph}" FontSize="11" />
                            </Border>
                            <c:ProgressRing x:Name="CompactRing" Width="18" Height="18" Margin="4,0,0,0" Thickness="2.6"
                                            RingBrush="{StaticResource TimerBrush}" Visibility="Collapsed" />
                        </Grid>
                        <!-- Live lyrics: the line being sung right now -->
                        <TextBlock x:Name="CompactLyric" Grid.Column="1" Margin="10,0,10,0" FontSize="12.5" FontWeight="SemiBold"
                                   TextAlignment="Center" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                   Visibility="Collapsed">
                            <TextBlock.RenderTransform>
                                <TranslateTransform x:Name="CompactLyricShift" />
                            </TextBlock.RenderTransform>
                        </TextBlock>
                        <StackPanel Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center" Orientation="Horizontal" Margin="0,0,13,0">
                            <StackPanel x:Name="CompactShelfBadge" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,9,0"
                                        Background="Transparent" Cursor="Hand" Visibility="Collapsed"
                                        MouseLeftButtonUp="ShelfBadge_MouseLeftButtonUp">
                                <Viewbox Width="12" Height="12" VerticalAlignment="Center">
                                    <Grid Width="16" Height="16">
                                        <Path Data="{StaticResource IconTray}" Style="{StaticResource StrokeIcon}" StrokeThickness="1.7"
                                              StrokeLineJoin="Round" Stroke="{StaticResource SecondaryText}" />
                                    </Grid>
                                </Viewbox>
                                <TextBlock x:Name="CompactShelfCount" FontSize="11" FontWeight="SemiBold" Margin="4,0,0,0"
                                           VerticalAlignment="Center" Foreground="{StaticResource SecondaryText}" />
                            </StackPanel>
                            <Ellipse x:Name="CompactMicDot" Width="6" Height="6" Margin="0,0,7,0" VerticalAlignment="Center"
                                     Fill="{StaticResource MicBrush}" Visibility="Collapsed" />
                            <Ellipse x:Name="CompactCameraDot" Width="6" Height="6" Margin="0,0,7,0" VerticalAlignment="Center"
                                     Fill="{StaticResource CameraBrush}" Visibility="Collapsed" />
                            <c:EqualizerBars x:Name="CompactEq" BarHeight="13" />
                            <TextBlock x:Name="CompactTimerText" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"
                                       Foreground="{StaticResource TimerBrush}" Visibility="Collapsed" />
                        </StackPanel>
                    </Grid>

                    <!-- Transient activities -->
                    <Grid x:Name="ActivityView" VerticalAlignment="Top" Visibility="Collapsed">

                        <Grid x:Name="VolumePanel" Visibility="Collapsed">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="44" />
                            </Grid.ColumnDefinitions>
                            <Viewbox Width="18" Height="18" Margin="14,0,12,0" VerticalAlignment="Center">
                                <Grid Width="16" Height="16">
                                    <Path Data="{StaticResource IconSpeaker}" Style="{StaticResource SolidIcon}" StrokeThickness="1" />
                                    <Path x:Name="WaveSmall" Data="{StaticResource IconWaveSmall}" Style="{StaticResource StrokeIcon}" />
                                    <Path x:Name="WaveLarge" Data="{StaticResource IconWaveLarge}" Style="{StaticResource StrokeIcon}" />
                                    <Path x:Name="MuteMark" Data="{StaticResource IconMute}" Style="{StaticResource StrokeIcon}" Visibility="Collapsed" />
                                </Grid>
                            </Viewbox>
                            <Grid Grid.Column="1" Height="5" VerticalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition x:Name="VolumeDone" Width="0.5*" />
                                    <ColumnDefinition x:Name="VolumeRest" Width="0.5*" />
                                </Grid.ColumnDefinitions>
                                <Border Grid.ColumnSpan="2" CornerRadius="2.5" Background="{StaticResource TrackBrush}" />
                                <Border x:Name="VolumeFill" CornerRadius="2.5" Background="White" />
                            </Grid>
                            <TextBlock x:Name="VolumeText" Grid.Column="2" FontSize="13" FontWeight="SemiBold"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,4,0" />
                        </Grid>

                        <Grid x:Name="PowerPanel" Visibility="Collapsed">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="PowerTitle" FontSize="13" FontWeight="SemiBold" Margin="18,0,0,0"
                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="0,0,15,0" VerticalAlignment="Center">
                                <TextBlock x:Name="PowerPercent" FontSize="13" FontWeight="SemiBold" Margin="0,0,8,0"
                                           VerticalAlignment="Center" />
                                <c:BatteryIcon x:Name="PowerBattery" VerticalAlignment="Center" />
                            </StackPanel>
                        </Grid>

                        <Grid x:Name="TrackPanel" Visibility="Collapsed">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border x:Name="TrackArt" Style="{StaticResource Artwork}" Width="36" Height="36"
                                    CornerRadius="10" Margin="8,0,12,0">
                                <TextBlock Style="{StaticResource ArtworkGlyph}" FontSize="15" />
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock x:Name="TrackTitle" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                <TextBlock x:Name="TrackArtist" FontSize="12" Foreground="{StaticResource SecondaryText}"
                                           TextTrimming="CharacterEllipsis" Margin="0,1,0,0" />
                            </StackPanel>
                            <c:EqualizerBars x:Name="TrackEq" Grid.Column="2" Margin="12,0,20,0" BarHeight="16" />
                        </Grid>

                        <!-- Generic icon + title + subtitle: audio device, mic / camera, timer finished -->
                        <Grid x:Name="InfoPanel" Visibility="Collapsed">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Viewbox x:Name="InfoIcon" Width="20" Height="20" Margin="16,0,12,0" VerticalAlignment="Center">
                                <Grid Width="16" Height="16">
                                    <Path x:Name="InfoIconFill" Fill="White" />
                                    <Path x:Name="InfoIconStroke" Style="{StaticResource StrokeIcon}" StrokeLineJoin="Round" />
                                </Grid>
                            </Viewbox>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,18,0">
                                <TextBlock x:Name="InfoTitle" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                <TextBlock x:Name="InfoSubtitle" FontSize="12" Foreground="{StaticResource SecondaryText}"
                                           TextTrimming="CharacterEllipsis" Margin="0,1,0,0" />
                            </StackPanel>
                        </Grid>
                    </Grid>

                    <!-- Expanded: a swipeable carousel of pages (music, timer, today) -->
                    <Grid x:Name="CarouselView" VerticalAlignment="Top" Visibility="Collapsed">
                        <!-- Canvas: pages keep their full size off-screen; the island's clip hides them -->
                        <Canvas x:Name="PageViewport" Background="Transparent"
                                MouseLeftButtonDown="PageViewport_MouseLeftButtonDown"
                                MouseMove="PageViewport_MouseMove"
                                MouseLeftButtonUp="PageViewport_MouseLeftButtonUp"
                                LostMouseCapture="PageViewport_LostMouseCapture">
                            <StackPanel x:Name="PageStrip" Orientation="Horizontal">

                                <!-- Page: music -->
                                <Grid x:Name="MediaPage" Width="400" Height="176" VerticalAlignment="Top">
                                    <!-- Ambient light: the artwork shrunk to a few pixels and stretched back out -->
                                    <Border x:Name="MediaGlow" Opacity="0" IsHitTestVisible="False"
                                            RenderOptions.BitmapScalingMode="HighQuality">
                                        <Border.OpacityMask>
                                            <RadialGradientBrush Center="0.2,0.3" GradientOrigin="0.2,0.3" RadiusX="0.8" RadiusY="1.15">
                                                <GradientStop Offset="0" Color="#FF000000" />
                                                <GradientStop Offset="0.55" Color="#66000000" />
                                                <GradientStop Offset="1" Color="#00000000" />
                                            </RadialGradientBrush>
                                        </Border.OpacityMask>
                                    </Border>

                                    <Grid Margin="20,18,20,10">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <!-- Tap the artwork to bring the player to the front -->
                                            <Border x:Name="MediaArt" Style="{StaticResource Artwork}" Width="60" Height="60" CornerRadius="14"
                                                    Tag="open-app" Cursor="Hand">
                                                <Border.Effect>
                                                    <DropShadowEffect x:Name="MediaArtGlow" ShadowDepth="0" BlurRadius="22" Opacity="0.55" Color="Black" />
                                                </Border.Effect>
                                                <TextBlock Style="{StaticResource ArtworkGlyph}" FontSize="22" />
                                            </Border>
                                            <StackPanel Grid.Column="1" Margin="14,0,12,0" VerticalAlignment="Center">
                                                <TextBlock x:Name="MediaTitle" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                <TextBlock x:Name="MediaArtist" FontSize="13" Foreground="{StaticResource SecondaryText}"
                                                           TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                                            </StackPanel>
                                            <c:EqualizerBars x:Name="MediaEq" Grid.Column="2" BarHeight="18" Margin="0,0,2,0" />
                                        </Grid>

                                        <Grid x:Name="MediaTimeline" Grid.Row="1" Margin="0,13,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="42" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="42" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock x:Name="MediaElapsed" FontSize="11" Foreground="{StaticResource TertiaryText}" VerticalAlignment="Center" />
                                            <!-- 16px transparent strip = comfortable target; the bar grows and shows a knob on hover, drag to scrub -->
                                            <Grid x:Name="MediaTrack" Grid.Column="1" Height="16" Background="Transparent" Cursor="Hand"
                                                  MouseEnter="MediaTrack_MouseEnter" MouseLeave="MediaTrack_MouseLeave"
                                                  MouseLeftButtonDown="MediaTrack_MouseLeftButtonDown" MouseMove="MediaTrack_MouseMove"
                                                  MouseLeftButtonUp="MediaTrack_MouseLeftButtonUp" LostMouseCapture="MediaTrack_LostMouseCapture">
                                                <Grid x:Name="MediaBar" Height="5" VerticalAlignment="Center">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition x:Name="MediaProgressDone" Width="0*" />
                                                        <ColumnDefinition x:Name="MediaProgressRest" Width="1*" />
                                                    </Grid.ColumnDefinitions>
                                                    <Border Grid.ColumnSpan="2" CornerRadius="4" Background="{StaticResource TrackBrush}" />
                                                    <Border CornerRadius="4" Background="White" />
                                                    <Ellipse x:Name="MediaKnob" Width="12" Height="12" Fill="White" HorizontalAlignment="Right"
                                                             Margin="0,-4,-6,-4" Opacity="0" />
                                                </Grid>
                                            </Grid>
                                            <TextBlock x:Name="MediaRemaining" Grid.Column="2" FontSize="11" Foreground="{StaticResource TertiaryText}"
                                                       HorizontalAlignment="Right" VerticalAlignment="Center" />
                                        </Grid>

                                        <!-- Controls: lyrics · previous · play/pause · next · open the player -->
                                        <Grid Grid.Row="2" VerticalAlignment="Center">
                                            <Button x:Name="LyricsButton" Style="{StaticResource IconButton}" Width="36" Height="36"
                                                    HorizontalAlignment="Left" Click="LyricsButton_Click" ToolTip="Lirik">
                                                <Viewbox Width="17" Height="17">
                                                    <Grid Width="16" Height="16">
                                                        <Path Data="{StaticResource IconLyricsBubble}" Style="{StaticResource StrokeIcon}" StrokeLineJoin="Round" />
                                                        <Path Data="{StaticResource IconLyricsQuotes}" Fill="White" />
                                                    </Grid>
                                                </Viewbox>
                                            </Button>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                <Button x:Name="PreviousButton" Style="{StaticResource IconButton}" Margin="0,0,14,0" Click="Previous_Click">
                                                    <Viewbox Width="20" Height="20">
                                                        <Path Width="16" Height="16" Data="{StaticResource IconPrevious}" Style="{StaticResource SolidIcon}" />
                                                    </Viewbox>
                                                </Button>
                                                <Button x:Name="PlayPauseButton" Style="{StaticResource IconButton}" Width="48" Height="48" Click="PlayPause_Click">
                                                    <Viewbox Width="23" Height="23" RenderTransformOrigin="0.5,0.5">
                                                        <Viewbox.RenderTransform>
                                                            <ScaleTransform x:Name="PlayPauseScale" />
                                                        </Viewbox.RenderTransform>
                                                        <Path x:Name="PlayPauseIcon" Width="16" Height="16" Data="{StaticResource IconPlay}" Style="{StaticResource SolidIcon}" />
                                                    </Viewbox>
                                                </Button>
                                                <Button x:Name="NextButton" Style="{StaticResource IconButton}" Margin="14,0,0,0" Click="Next_Click">
                                                    <Viewbox Width="20" Height="20">
                                                        <Path Width="16" Height="16" Data="{StaticResource IconNext}" Style="{StaticResource SolidIcon}" />
                                                    </Viewbox>
                                                </Button>
                                            </StackPanel>
                                            <Button x:Name="OpenAppButton" Style="{StaticResource IconButton}" Width="36" Height="36"
                                                    HorizontalAlignment="Right" Click="OpenAppButton_Click">
                                                <Viewbox Width="15" Height="15">
                                                    <Grid Width="16" Height="16">
                                                        <Path Data="{StaticResource IconOpenApp}" Style="{StaticResource StrokeIcon}" StrokeLineJoin="Round" />
                                                    </Grid>
                                                </Viewbox>
                                            </Button>
                                        </Grid>
                                    </Grid>
                                </Grid>

                                <!-- Page: lyrics, karaoke style (LRCLIB) -->
                                <Grid x:Name="LyricsPage" Width="400" Height="168" VerticalAlignment="Top">
                                    <Border x:Name="LyricsGlow" Opacity="0" IsHitTestVisible="False"
                                            RenderOptions.BitmapScalingMode="HighQuality">
                                        <Border.OpacityMask>
                                            <RadialGradientBrush Center="0.15,0.1" GradientOrigin="0.15,0.1" RadiusX="0.9" RadiusY="1.3">
                                                <GradientStop Offset="0" Color="#FF000000" />
                                                <GradientStop Offset="0.6" Color="#40000000" />
                                                <GradientStop Offset="1" Color="#00000000" />
                                            </RadialGradientBrush>
                                        </Border.OpacityMask>
                                    </Border>
                                    <Grid Margin="22,14,22,0" VerticalAlignment="Top">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <!-- Tap the header to go back to the music page -->
                                        <Grid Background="Transparent" Tag="go-media" Cursor="Hand">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Border x:Name="LyricsArt" Style="{StaticResource Artwork}" Width="26" Height="26" CornerRadius="7" Margin="0,0,10,0">
                                                <TextBlock Style="{StaticResource ArtworkGlyph}" FontSize="11" />
                                            </Border>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock x:Name="LyricsHeader" FontSize="12.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                <TextBlock x:Name="LyricsArtist" FontSize="11" Foreground="{StaticResource SecondaryText}" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                            <TextBlock x:Name="LyricsSource" Grid.Column="2" FontSize="10.5" Margin="10,0,0,0"
                                                       Foreground="{StaticResource TertiaryText}" VerticalAlignment="Center" />
                                        </Grid>
                                        <!-- Lines roll upwards; the mask fades them out at the top and bottom edge -->
                                        <Grid x:Name="LyricsViewport" Grid.Row="1" Height="122" Margin="0,6,0,0" ClipToBounds="True" Background="Transparent">
                                            <!-- Absolute mapping: relative would stretch over the whole (very tall) lyric sheet -->
                                            <Grid.OpacityMask>
                                                <LinearGradientBrush MappingMode="Absolute" StartPoint="0,0" EndPoint="0,122">
                                                    <GradientStop Offset="0" Color="#00000000" />
                                                    <GradientStop Offset="0.2" Color="#FF000000" />
                                                    <GradientStop Offset="0.8" Color="#FF000000" />
                                                    <GradientStop Offset="1" Color="#00000000" />
                                                </LinearGradientBrush>
                                            </Grid.OpacityMask>
                                            <!-- Canvas: no layout clip, so the rolled sheet is not cut off before it is moved -->
                                            <Canvas>
                                                <StackPanel x:Name="LyricsLines" Width="356" />
                                            </Canvas>
                                            <TextBlock x:Name="LyricsMessage" FontSize="13" Foreground="{StaticResource SecondaryText}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Grid>
                                    </Grid>
                                </Grid>

                                <!-- Page: timer (start buttons, or the running countdown) -->
                                <Grid x:Name="TimerPage" Width="400" Height="100" VerticalAlignment="Top">
                                    <Grid x:Name="TimerIdle" Margin="24,18,24,0" VerticalAlignment="Top">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <StackPanel Orientation="Horizontal">
                                            <Viewbox Width="17" Height="17" Margin="0,0,9,0" VerticalAlignment="Center">
                                                <Grid Width="16" Height="16">
                                                    <Path Data="{StaticResource IconStopwatch}" Style="{StaticResource StrokeIcon}"
                                                          Stroke="{StaticResource TimerBrush}" StrokeLineJoin="Round" />
                                                </Grid>
                                            </Viewbox>
                                            <TextBlock Text="Timer" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
                                            <TextBlock Text="  ·  pilih durasi" FontSize="13" Foreground="{StaticResource TertiaryText}" VerticalAlignment="Center" />
                                        </StackPanel>
                                        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,12,0,0">
                                            <Button Style="{StaticResource PillButton}" Content="5 mnt" Tag="5" Click="TimerPreset_Click" Margin="0,0,6,0" />
                                            <Button Style="{StaticResource PillButton}" Content="10 mnt" Tag="10" Click="TimerPreset_Click" Margin="0,0,6,0" />
                                            <Button Style="{StaticResource PillButton}" Content="15 mnt" Tag="15" Click="TimerPreset_Click" Margin="0,0,6,0" />
                                            <Button Style="{StaticResource PillButton}" Content="25 mnt" Tag="25" Click="TimerPreset_Click" Margin="0,0,6,0" />
                                            <Button Style="{StaticResource PillButton}" Content="45 mnt" Tag="45" Click="TimerPreset_Click" />
                                        </StackPanel>
                                    </Grid>

                                    <Grid x:Name="TimerRunning" Height="64" VerticalAlignment="Top" Margin="22,18,16,0" Visibility="Collapsed">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Grid Width="46" Height="46" VerticalAlignment="Center">
                                            <c:ProgressRing x:Name="TimerRing" Thickness="4" RingBrush="{StaticResource TimerBrush}" />
                                            <Viewbox Width="18" Height="18">
                                                <Grid Width="16" Height="16">
                                                    <Path Data="{StaticResource IconStopwatch}" Style="{StaticResource StrokeIcon}"
                                                          Stroke="{StaticResource TimerBrush}" StrokeLineJoin="Round" />
                                                </Grid>
                                            </Viewbox>
                                        </Grid>
                                        <StackPanel Grid.Column="1" Margin="14,0,8,0" VerticalAlignment="Center">
                                            <TextBlock x:Name="TimerLabel" FontSize="12" Foreground="{StaticResource SecondaryText}" />
                                            <TextBlock x:Name="TimerText" FontSize="30" FontWeight="SemiBold" Margin="0,-3,0,0"
                                                       Foreground="{StaticResource TimerBrush}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button Style="{StaticResource PillButton}" Content="+1 mnt" Click="TimerAdd_Click" Margin="0,0,6,0" />
                                            <Button Style="{StaticResource IconButton}" Width="38" Height="38" Click="TimerPause_Click">
                                                <Viewbox Width="15" Height="15">
                                                    <Path x:Name="TimerPauseIcon" Width="16" Height="16" Data="{StaticResource IconPause}" Style="{StaticResource SolidIcon}" />
                                                </Viewbox>
                                            </Button>
                                            <Button Style="{StaticResource IconButton}" Width="38" Height="38" Click="TimerStop_Click">
                                                <Viewbox Width="13" Height="13">
                                                    <Grid Width="16" Height="16">
                                                        <Path Data="{StaticResource IconClose}" Style="{StaticResource StrokeIcon}" StrokeThickness="2" />
                                                    </Grid>
                                                </Viewbox>
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </Grid>

                                <!-- Page: today (clock, week strip, battery, audio output) -->
                                <Grid x:Name="TodayPage" Width="400" Height="148" VerticalAlignment="Top">
                                    <Grid Margin="26,18,26,0" VerticalAlignment="Top">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock x:Name="ClockTime" FontSize="30" FontWeight="SemiBold" />
                                                <TextBlock x:Name="ClockDate" FontSize="12.5" Foreground="{StaticResource SecondaryText}" Margin="1,-2,0,0" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <StackPanel x:Name="ClockBattery" Orientation="Horizontal" HorizontalAlignment="Right">
                                                    <TextBlock x:Name="ClockBatteryText" FontSize="13" FontWeight="SemiBold" Margin="0,0,8,0"
                                                               VerticalAlignment="Center" />
                                                    <c:BatteryIcon x:Name="ClockBatteryIcon" VerticalAlignment="Center" />
                                                </StackPanel>
                                                <StackPanel x:Name="ClockDevice" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,7,0,0">
                                                    <Viewbox Width="13" Height="13" Margin="0,0,6,0" VerticalAlignment="Center">
                                                        <Grid Width="16" Height="16">
                                                            <Path x:Name="ClockDeviceFill" Fill="{StaticResource SecondaryText}" />
                                                            <Path x:Name="ClockDeviceStroke" Style="{StaticResource StrokeIcon}" Stroke="{StaticResource SecondaryText}" />
                                                        </Grid>
                                                    </Viewbox>
                                                    <TextBlock x:Name="ClockDeviceText" FontSize="11.5" Foreground="{StaticResource SecondaryText}"
                                                               MaxWidth="150" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </StackPanel>
                                        </Grid>
                                        <!-- Seven columns, filled in code (localised day names, today highlighted) -->
                                        <UniformGrid x:Name="WeekStrip" Grid.Row="1" Rows="1" Columns="7" Margin="-6,14,-6,0" />
                                    </Grid>
                                </Grid>


                                <!-- Page: file shelf ("titipan"), like NotchDrop -->
                                <Grid x:Name="ShelfPage" Width="400" Height="134" VerticalAlignment="Top">
                                    <Grid x:Name="ShelfContent" Margin="22,16,22,0" VerticalAlignment="Top">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Orientation="Horizontal">
                                                <!-- Drag this icon to take every file at once -->
                                                <Border x:Name="ShelfDragAll" Background="Transparent" Cursor="SizeAll" Padding="2"
                                                        ToolTip="Seret untuk membawa semua file">
                                                    <Viewbox Width="17" Height="17">
                                                        <Grid Width="16" Height="16">
                                                            <Path Data="{StaticResource IconTray}" Style="{StaticResource StrokeIcon}" StrokeLineJoin="Round" />
                                                        </Grid>
                                                    </Viewbox>
                                                </Border>
                                                <TextBlock Text="Titipan" FontSize="15" FontWeight="SemiBold" Margin="7,0,0,0" VerticalAlignment="Center" />
                                                <TextBlock x:Name="ShelfCount" FontSize="13" Foreground="{StaticResource TertiaryText}" VerticalAlignment="Center" />
                                            </StackPanel>
                                            <Button Grid.Column="1" Style="{StaticResource PillButton}" Content="Bersihkan" Padding="11,4"
                                                    Click="ShelfClear_Click" />
                                        </Grid>
                                        <!-- Tiles are built in code: thumbnail + name, drag out, click to open, × to remove -->
                                        <StackPanel x:Name="ShelfTiles" Grid.Row="1" Orientation="Horizontal" Margin="-4,10,0,0" />
                                    </Grid>

                                    <!-- Drop zone: while files are dragged over the island, or when the shelf is empty -->
                                    <Grid x:Name="ShelfDropZone" Height="98" VerticalAlignment="Top" Margin="16,14,16,0" Visibility="Collapsed">
                                        <Rectangle x:Name="ShelfDropOutline" RadiusX="18" RadiusY="18" Fill="#E6000000"
                                                   Stroke="{StaticResource SecondaryText}" StrokeThickness="1.5" StrokeDashArray="4 3" />
                                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <Viewbox Width="24" Height="24">
                                                <Grid Width="16" Height="16">
                                                    <Path Data="{StaticResource IconTray}" Style="{StaticResource StrokeIcon}" StrokeLineJoin="Round" StrokeThickness="1.3" />
                                                </Grid>
                                            </Viewbox>
                                            <TextBlock x:Name="ShelfDropTitle" Text="Lepaskan untuk menitip file" FontSize="13" FontWeight="SemiBold"
                                                       HorizontalAlignment="Center" Margin="0,8,0,0" />
                                            <TextBlock Text="File tetap di tempat aslinya" FontSize="11" Foreground="{StaticResource TertiaryText}"
                                                       HorizontalAlignment="Center" Margin="0,2,0,0" />
                                        </StackPanel>
                                    </Grid>
                                </Grid>

                            </StackPanel>
                        </Canvas>
                    </Grid>

                    <!-- Pagination dots, pinned to the island's (animated) bottom edge -->
                    <StackPanel x:Name="PageDots" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Bottom"
                                Margin="0,0,0,4" Opacity="0" IsHitTestVisible="False" />

                    <!-- Volume feedback while the island is open: takes the dots' place for a moment -->
                    <StackPanel x:Name="VolumeHud" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Bottom"
                                Margin="0,0,0,7" Opacity="0" IsHitTestVisible="False">
                        <Viewbox Width="12" Height="12" VerticalAlignment="Center">
                            <Grid Width="16" Height="16">
                                <Path Data="{StaticResource IconSpeaker}" Style="{StaticResource SolidIcon}" StrokeThickness="1" />
                                <Path x:Name="HudWaves" Data="{StaticResource IconSpeakerWaves}" Style="{StaticResource StrokeIcon}" />
                                <Path x:Name="HudMute" Data="{StaticResource IconMute}" Style="{StaticResource StrokeIcon}" Visibility="Collapsed" />
                            </Grid>
                        </Viewbox>
                        <Grid Width="110" Height="4" Margin="8,0" VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition x:Name="HudDone" Width="0.5*" />
                                <ColumnDefinition x:Name="HudRest" Width="0.5*" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.ColumnSpan="2" CornerRadius="2" Background="{StaticResource TrackBrush}" />
                            <Border x:Name="HudFill" CornerRadius="2" Background="White" />
                        </Grid>
                        <TextBlock x:Name="HudText" Width="22" FontSize="10.5" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </StackPanel>

                </Grid>
            </Border>

            <Path x:Name="ShoulderRight" Data="{StaticResource NotchShoulder}" Fill="{StaticResource IslandBrush}"
                  VerticalAlignment="Top" Margin="-1,0,0,0" RenderTransformOrigin="0.5,0.5" Visibility="Collapsed">
                <Path.RenderTransform>
                    <ScaleTransform ScaleX="-1" />
                </Path.RenderTransform>
            </Path>
        </StackPanel>
    </Grid>
</Window>
