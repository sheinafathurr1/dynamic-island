<Window x:Class="DynamicIsland.CalendarDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Kalender · Dynamic Island"
        Width="460" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="NoResize"
        Topmost="True" WindowStartupLocation="CenterScreen"
        FontFamily="{StaticResource UiFont}" Foreground="{StaticResource PrimaryText}">

    <!-- Same look as the island: black, rounded, quiet. Drag anywhere to move it. -->
    <Border Background="#FF1C1C1E" BorderBrush="{StaticResource MenuBorder}" BorderThickness="1" CornerRadius="18"
            Padding="24,20,24,20" MouseLeftButtonDown="Chrome_MouseLeftButtonDown">
        <StackPanel>
            <StackPanel Orientation="Horizontal">
                <Viewbox Width="20" Height="20" VerticalAlignment="Center">
                    <Grid Width="16" Height="16">
                        <Path Data="{StaticResource IconCalendar}" Style="{StaticResource StrokeIcon}"
                              Stroke="{StaticResource CalendarBrush}" StrokeLineJoin="Round" />
                    </Grid>
                </Viewbox>
                <TextBlock Text="Agenda dari kalender" FontSize="16" FontWeight="SemiBold" Margin="10,0,0,0" VerticalAlignment="Center" />
            </StackPanel>

            <TextBlock FontSize="12.5" Foreground="{StaticResource SecondaryText}" TextWrapping="Wrap" Margin="0,10,0,0"
                       Text="Tempel link iCal kalendermu. Agenda hari ini dan besok akan tampil di halaman Hari ini, dan hari yang ada acaranya diberi titik." />

            <Border Background="{StaticResource CardBrush}" CornerRadius="12" Padding="12,9" Margin="0,12,0,0">
                <StackPanel>
                    <TextBlock FontSize="11.5" Foreground="{StaticResource SecondaryText}" TextWrapping="Wrap">
                        <Run FontWeight="SemiBold" Foreground="{StaticResource PrimaryText}">Google Calendar:</Run>
                        <Run>Setelan → pilih kalender → Integrasikan kalender → "Alamat rahasia dalam format iCal".</Run>
                    </TextBlock>
                    <TextBlock FontSize="11.5" Foreground="{StaticResource SecondaryText}" TextWrapping="Wrap" Margin="0,6,0,0">
                        <Run FontWeight="SemiBold" Foreground="{StaticResource PrimaryText}">Outlook:</Run>
                        <Run>Setelan → Kalender → Kalender bersama → Publikasikan kalender → link ICS.</Run>
                    </TextBlock>
                    <TextBlock FontSize="11.5" Foreground="{StaticResource SecondaryText}" TextWrapping="Wrap" Margin="0,6,0,0">
                        <Run FontWeight="SemiBold" Foreground="{StaticResource PrimaryText}">iCloud:</Run>
                        <Run>bagikan kalender sebagai "Kalender Publik", lalu salin link webcal://-nya.</Run>
                    </TextBlock>
                </StackPanel>
            </Border>

            <Grid Margin="0,14,0,0">
                <Border x:Name="InputChrome" Background="#FF2C2C2E" CornerRadius="10" BorderThickness="1" BorderBrush="Transparent" />
                <TextBox x:Name="SourceBox" AutomationProperties.Name="Link iCal" Background="Transparent" BorderThickness="0"
                         Foreground="{StaticResource PrimaryText}" CaretBrush="White" SelectionBrush="{StaticResource CalendarBrush}"
                         FontSize="13" Padding="10,9" VerticalContentAlignment="Center"
                         TextChanged="SourceBox_TextChanged" GotKeyboardFocus="SourceBox_FocusChanged" LostKeyboardFocus="SourceBox_FocusChanged" />
                <TextBlock x:Name="Placeholder" Text="https://calendar.google.com/calendar/ical/…/basic.ics" FontSize="13"
                           Foreground="{StaticResource TertiaryText}" Margin="13,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False" />
            </Grid>
            <TextBlock x:Name="ErrorText" FontSize="11.5" Foreground="{StaticResource WarningBrush}" TextWrapping="Wrap"
                       Margin="2,6,0,0" Visibility="Collapsed" />
            <TextBlock FontSize="11" Foreground="{StaticResource TertiaryText}" TextWrapping="Wrap" Margin="2,8,0,0"
                       Text="Link ini rahasia: disimpan hanya di PC ini dan dipakai untuk membaca kalender saja." />

            <Grid Margin="0,18,0,0">
                <Button x:Name="RemoveButton" Style="{StaticResource PillButton}" Content="Putuskan kalender" Padding="14,7"
                        HorizontalAlignment="Left" Click="Remove_Click" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{StaticResource PillButton}" Content="Batal" Padding="16,7" IsCancel="True" Click="Cancel_Click" />
                    <Button Style="{StaticResource PillButton}" Content="Simpan" Padding="18,7" Margin="8,0,0,0" IsDefault="True"
                            Background="{StaticResource CalendarBrush}" Click="Save_Click" />
                </StackPanel>
            </Grid>
        </StackPanel>
    </Border>
</Window>
