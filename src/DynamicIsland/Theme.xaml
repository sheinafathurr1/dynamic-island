<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <FontFamily x:Key="UiFont">Segoe UI</FontFamily>

    <SolidColorBrush x:Key="IslandBrush" Color="#FF000000" />
    <SolidColorBrush x:Key="PrimaryText" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="SecondaryText" Color="#99FFFFFF" />
    <SolidColorBrush x:Key="TertiaryText" Color="#66FFFFFF" />
    <SolidColorBrush x:Key="TrackBrush" Color="#33FFFFFF" />
    <SolidColorBrush x:Key="ArtPlaceholder" Color="#FF2A2A2D" />
    <SolidColorBrush x:Key="ChargingBrush" Color="#FF30D158" />
    <SolidColorBrush x:Key="WarningBrush" Color="#FFFF453A" />
    <SolidColorBrush x:Key="SaverBrush" Color="#FFFFD60A" />
    <SolidColorBrush x:Key="TimerBrush" Color="#FFFF9F0A" />
    <SolidColorBrush x:Key="MicBrush" Color="#FFFF9F0A" />
    <SolidColorBrush x:Key="CameraBrush" Color="#FF30D158" />
    <SolidColorBrush x:Key="DividerBrush" Color="#1AFFFFFF" />
    <SolidColorBrush x:Key="CalendarBrush" Color="#FF0A84FF" />
    <SolidColorBrush x:Key="CallBrush" Color="#FF30D158" />
    <SolidColorBrush x:Key="ControlOffBrush" Color="#FF2C2C2E" />
    <SolidColorBrush x:Key="WindowBrush" Color="#FF1C1C1E" />
    <SolidColorBrush x:Key="CardBrush" Color="#14FFFFFF" />
    <SolidColorBrush x:Key="TimerTrackBrush" Color="#38FF9F0A" />
    <SolidColorBrush x:Key="WarningTrackBrush" Color="#38FF453A" />
    <SolidColorBrush x:Key="MenuBackground" Color="#F21C1C1E" />
    <SolidColorBrush x:Key="MenuBorder" Color="#24FFFFFF" />
    <SolidColorBrush x:Key="MenuHighlight" Color="#22FFFFFF" />

    <!-- Icons are drawn on a 16x16 grid and scaled with a Viewbox. -->
    <StreamGeometry x:Key="IconPlay">M4.5,2.5 L13.5,8 L4.5,13.5 Z</StreamGeometry>
    <GeometryGroup x:Key="IconPause">
        <RectangleGeometry Rect="3,1.5,3.6,13" RadiusX="1.2" RadiusY="1.2" />
        <RectangleGeometry Rect="9.4,1.5,3.6,13" RadiusX="1.2" RadiusY="1.2" />
    </GeometryGroup>
    <StreamGeometry x:Key="IconNext">M1.5,3 L8,8 L1.5,13 Z M8,3 L14.5,8 L8,13 Z</StreamGeometry>
    <StreamGeometry x:Key="IconPrevious">M14.5,3 L8,8 L14.5,13 Z M8,3 L1.5,8 L8,13 Z</StreamGeometry>
    <StreamGeometry x:Key="IconSpeaker">M1.5,5.5 L4.5,5.5 L8.5,2 L8.5,14 L4.5,10.5 L1.5,10.5 Z</StreamGeometry>
    <StreamGeometry x:Key="IconWaveSmall">M10.8,5.6 A2.6,2.6 0 0 1 10.8,10.4</StreamGeometry>
    <StreamGeometry x:Key="IconWaveLarge">M12.4,3.2 A5.2,5.2 0 0 1 12.4,12.8</StreamGeometry>
    <StreamGeometry x:Key="IconMute">M11,5.5 L15.5,10.5 M15.5,5.5 L11,10.5</StreamGeometry>
    <StreamGeometry x:Key="IconSpeakerWaves">M10.8,5.6 A2.6,2.6 0 0 1 10.8,10.4 M12.4,3.2 A5.2,5.2 0 0 1 12.4,12.8</StreamGeometry>
    <StreamGeometry x:Key="IconClose">M4,4 L12,12 M12,4 L4,12</StreamGeometry>
    <StreamGeometry x:Key="IconStopwatch">M8,3.6 A5.7,5.7 0 0 1 8,15 A5.7,5.7 0 0 1 8,3.6 M8,6.4 L8,9.3 L10.1,10.8 M6.4,1.3 L9.6,1.3 M8,1.3 L8,3.6</StreamGeometry>
    <!-- Microphone: filled capsule + stroked stand -->
    <StreamGeometry x:Key="IconMicBody">M8,1 A2.6,2.6 0 0 1 10.6,3.6 L10.6,7.6 A2.6,2.6 0 0 1 5.4,7.6 L5.4,3.6 A2.6,2.6 0 0 1 8,1 Z</StreamGeometry>
    <StreamGeometry x:Key="IconMicStand">M3.2,7.4 A4.8,4.8 0 0 0 12.8,7.4 M8,12.2 L8,14.8 M5.6,14.8 L10.4,14.8</StreamGeometry>
    <!-- Video camera -->
    <GeometryGroup x:Key="IconCamera">
        <RectangleGeometry Rect="0.8,4,10,8" RadiusX="2" RadiusY="2" />
        <PathGeometry Figures="M11.6,7.2 L15.2,5 L15.2,11 L11.6,8.8 Z" />
    </GeometryGroup>
    <!-- Headphones: filled ear cups + stroked band -->
    <GeometryGroup x:Key="IconHeadphoneCups">
        <RectangleGeometry Rect="1.2,9,3.4,5.6" RadiusX="1.4" RadiusY="1.4" />
        <RectangleGeometry Rect="11.4,9,3.4,5.6" RadiusX="1.4" RadiusY="1.4" />
    </GeometryGroup>
    <!-- Speech bubble with quotes: lyrics (bubble stroked, quotes filled) -->
    <StreamGeometry x:Key="IconLyricsBubble">M3.2,2.2 L12.8,2.2 A1.7,1.7 0 0 1 14.5,3.9 L14.5,9.9 A1.7,1.7 0 0 1 12.8,11.6 L7.4,11.6 L4.2,14.2 L4.2,11.6 L3.2,11.6 A1.7,1.7 0 0 1 1.5,9.9 L1.5,3.9 A1.7,1.7 0 0 1 3.2,2.2 Z</StreamGeometry>
    <StreamGeometry x:Key="IconLyricsQuotes">M4.8,5.2 L7.2,5.2 L7.2,7.4 C7.2,8.6 6.6,9.3 5.4,9.6 L5.1,8.9 C5.7,8.7 6,8.3 6,7.6 L4.8,7.6 Z M8.8,5.2 L11.2,5.2 L11.2,7.4 C11.2,8.6 10.6,9.3 9.4,9.6 L9.1,8.9 C9.7,8.7 10,8.3 10,7.6 L8.8,7.6 Z</StreamGeometry>
    <!-- Arrow out of a box: open the player app -->
    <StreamGeometry x:Key="IconOpenApp">M9.5,2 L14,2 L14,6.5 M14,2 L7.5,8.5 M12,9.5 L12,12.6 A1.4,1.4 0 0 1 10.6,14 L3.4,14 A1.4,1.4 0 0 1 2,12.6 L2,5.4 A1.4,1.4 0 0 1 3.4,4 L6.5,4</StreamGeometry>

    <!-- Calendar page with two rings -->
    <StreamGeometry x:Key="IconCalendar">M3.2,3.2 L12.8,3.2 A1.7,1.7 0 0 1 14.5,4.9 L14.5,12.8 A1.7,1.7 0 0 1 12.8,14.5 L3.2,14.5 A1.7,1.7 0 0 1 1.5,12.8 L1.5,4.9 A1.7,1.7 0 0 1 3.2,3.2 Z M1.5,6.9 L14.5,6.9 M5,1.5 L5,4.4 M11,1.5 L11,4.4</StreamGeometry>
    <!-- Bell: an app notification without a picture -->
    <StreamGeometry x:Key="IconBell">M8,1.8 A4.2,4.2 0 0 1 12.2,6 L12.2,9.2 L13.8,11.6 L2.2,11.6 L3.8,9.2 L3.8,6 A4.2,4.2 0 0 1 8,1.8 Z M6.3,13.4 A1.8,1.8 0 0 0 9.7,13.4</StreamGeometry>

    <!-- Controls page -->
    <StreamGeometry x:Key="IconWifi">M1.6,6.4 A9.4,9.4 0 0 1 14.4,6.4 M4,9 A6,6 0 0 1 12,9 M6.4,11.6 A2.6,2.6 0 0 1 9.6,11.6</StreamGeometry>
    <EllipseGeometry x:Key="IconWifiDot" Center="8,13.9" RadiusX="1.3" RadiusY="1.3" />
    <StreamGeometry x:Key="IconBluetooth">M4.4,4.9 L11.6,11.1 L8,14.6 L8,1.4 L11.6,4.9 L4.4,11.1</StreamGeometry>
    <StreamGeometry x:Key="IconMoon">M10.2,1.6 A6.6,6.6 0 1 0 14.4,10.8 A5.2,5.2 0 0 1 10.2,1.6 Z</StreamGeometry>
    <StreamGeometry x:Key="IconSlash">M2.2,2.2 L13.8,13.8</StreamGeometry>
    <!-- Folder: "show in folder" -->
    <StreamGeometry x:Key="IconFolder">M1.8,4 A1.2,1.2 0 0 1 3,2.8 L6.2,2.8 L7.8,4.4 L13,4.4 A1.2,1.2 0 0 1 14.2,5.6 L14.2,12 A1.2,1.2 0 0 1 13,13.2 L3,13.2 A1.2,1.2 0 0 1 1.8,12 Z</StreamGeometry>
    <!-- Gear: settings -->
    <StreamGeometry x:Key="IconGear">M8,5.6 A2.4,2.4 0 1 1 8,10.4 A2.4,2.4 0 1 1 8,5.6 Z M8,1.5 L8,3 M8,13 L8,14.5 M1.5,8 L3,8 M13,8 L14.5,8 M3.4,3.4 L4.5,4.5 M11.5,11.5 L12.6,12.6 M3.4,12.6 L4.5,11.5 M11.5,4.5 L12.6,3.4</StreamGeometry>

    <!-- Inbox tray: the file shelf -->
    <StreamGeometry x:Key="IconTray">M2,9.2 L4.4,3 L11.6,3 L14,9.2 L14,13 L2,13 Z M2,9.2 L5.4,9.2 L6.4,10.9 L9.6,10.9 L10.6,9.2 L14,9.2</StreamGeometry>
    <StreamGeometry x:Key="IconHeadphoneBand">M2.4,10.5 L2.4,8.2 A5.6,5.6 0 0 1 13.6,8.2 L13.6,10.5</StreamGeometry>

    <!-- Concave corner that melts the notch into the top edge of the screen.
         One extra pixel column overlaps the island so no seam shows between the two shapes. -->
    <StreamGeometry x:Key="NotchShoulder">M0,0 L11,0 L11,10 L10,10 A10,10 0 0 0 0,0 Z</StreamGeometry>

    <Style x:Key="Artwork" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource ArtPlaceholder}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="RenderOptions.BitmapScalingMode" Value="HighQuality" />
    </Style>

    <Style x:Key="ArtworkGlyph" TargetType="TextBlock">
        <Setter Property="Text" Value="♪" />
        <Setter Property="Foreground" Value="{StaticResource TertiaryText}" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="FontFamily" Value="Segoe UI Symbol" />
    </Style>

    <Style x:Key="StrokeIcon" TargetType="Path">
        <Setter Property="Stroke" Value="White" />
        <Setter Property="StrokeThickness" Value="1.5" />
        <Setter Property="StrokeStartLineCap" Value="Round" />
        <Setter Property="StrokeEndLineCap" Value="Round" />
    </Style>

    <!-- Fill + stroke of the same colour gives the solid glyphs soft, rounded corners. -->
    <Style x:Key="SolidIcon" TargetType="Path">
        <Setter Property="Fill" Value="White" />
        <Setter Property="Stroke" Value="White" />
        <Setter Property="StrokeThickness" Value="1.4" />
        <Setter Property="StrokeLineJoin" Value="Round" />
    </Style>

    <!-- Rounded text button: timer chips, "+1 mnt" (set Background for a coloured one) -->
    <Style x:Key="PillButton" TargetType="Button">
        <Setter Property="Foreground" Value="White" />
        <Setter Property="Background" Value="#1FFFFFFF" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Padding" Value="12,5" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid x:Name="Chrome" RenderTransformOrigin="0.5,0.5">
                        <Border Background="{TemplateBinding Background}" CornerRadius="999" />
                        <Border x:Name="Hover" Background="#1FFFFFFF" CornerRadius="999" Opacity="0" />
                        <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Hover" Property="Opacity" Value="1" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Chrome" Property="RenderTransform">
                                <Setter.Value>
                                    <ScaleTransform ScaleX="0.94" ScaleY="0.94" />
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="IconButton" TargetType="Button">
        <Setter Property="Width" Value="40" />
        <Setter Property="Height" Value="40" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Chrome" Background="Transparent" CornerRadius="999" RenderTransformOrigin="0.5,0.5">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="#1AFFFFFF" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Chrome" Property="RenderTransform">
                                <Setter.Value>
                                    <ScaleTransform ScaleX="0.88" ScaleY="0.88" />
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.35" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- System page tiles -->
    <Style x:Key="StatTile" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource CardBrush}" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Padding" Value="11,7,11,7" />
        <Setter Property="Height" Value="68" />
    </Style>
    <Style x:Key="StatLabel" TargetType="TextBlock">
        <Setter Property="FontSize" Value="10.5" />
        <Setter Property="Foreground" Value="{StaticResource TertiaryText}" />
    </Style>
    <Style x:Key="StatValue" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <!-- Round quick-control button (controls page); Background / Foreground are set from code by state -->
    <Style x:Key="ControlButton" TargetType="Button">
        <Setter Property="Width" Value="48" />
        <Setter Property="Height" Value="48" />
        <Setter Property="Background" Value="{StaticResource ControlOffBrush}" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid x:Name="Chrome" RenderTransformOrigin="0.5,0.5">
                        <Ellipse Fill="{TemplateBinding Background}" />
                        <Ellipse x:Name="Hover" Fill="#1FFFFFFF" Opacity="0" />
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Hover" Property="Opacity" Value="1" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Chrome" Property="RenderTransform">
                                <Setter.Value>
                                    <ScaleTransform ScaleX="0.9" ScaleY="0.9" />
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.35" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- iOS-style switch with its label on the left (settings window) -->
    <Style x:Key="SwitchRow" TargetType="CheckBox">
        <Setter Property="Foreground" Value="{StaticResource PrimaryText}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Padding" Value="14,9" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Border x:Name="Row" Background="Transparent" Padding="{TemplateBinding Padding}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ContentPresenter VerticalAlignment="Center" Margin="0,0,12,0" />
                            <Border x:Name="Track" Grid.Column="1" Width="40" Height="24" CornerRadius="12" Background="#FF39393D">
                                <Ellipse x:Name="Knob" Width="20" Height="20" Fill="White" HorizontalAlignment="Left" Margin="2,0" />
                            </Border>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Track" Property="Background" Value="{StaticResource CallBrush}" />
                            <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Row" Property="Background" Value="#0DFFFFFF" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- One half of a two-way segmented choice (settings window) -->
    <Style x:Key="Segment" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{StaticResource SecondaryText}" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Chrome" Background="Transparent" CornerRadius="8" Padding="12,7">
                        <ContentPresenter HorizontalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="#FF48484A" />
                            <Setter Property="Foreground" Value="White" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Dark, rounded context menu that matches the island. -->
    <Style TargetType="ContextMenu">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="HasDropShadow" Value="False" />
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{StaticResource PrimaryText}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContextMenu">
                    <Border Background="{StaticResource MenuBackground}" BorderBrush="{StaticResource MenuBorder}"
                            BorderThickness="1" CornerRadius="12" Padding="5" MinWidth="230">
                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="MenuItem">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Foreground" Value="{StaticResource PrimaryText}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="MenuItem">
                    <Grid>
                        <Border x:Name="Chrome" Background="Transparent" CornerRadius="7" Padding="8,7,16,7">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="24" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Path x:Name="Check" Data="M1,5 L4.5,8.5 L11,1.5" Stroke="{TemplateBinding Foreground}"
                                      StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      StrokeLineJoin="Round" VerticalAlignment="Center" Visibility="Hidden" />
                                <ContentPresenter Grid.Column="1" ContentSource="Header" RecognizesAccessKey="True"
                                                  VerticalAlignment="Center" />
                                <Path x:Name="Arrow" Grid.Column="2" Data="M0,0 L4,4 L0,8" Stroke="{StaticResource SecondaryText}"
                                      StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      StrokeLineJoin="Round" VerticalAlignment="Center" Margin="16,0,-6,0" Visibility="Collapsed" />
                            </Grid>
                        </Border>
                        <Popup x:Name="Submenu" Placement="Right" HorizontalOffset="8" VerticalOffset="-6"
                               IsOpen="{Binding IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}"
                               AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
                            <Border Background="{StaticResource MenuBackground}" BorderBrush="{StaticResource MenuBorder}"
                                    BorderThickness="1" CornerRadius="12" Padding="5" MinWidth="200">
                                <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle" />
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Role" Value="SubmenuHeader">
                            <Setter TargetName="Arrow" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Check" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{StaticResource MenuHighlight}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{StaticResource TertiaryText}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="{x:Static MenuItem.SeparatorStyleKey}" TargetType="Separator">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Separator">
                    <Border Height="1" Margin="10,4" Background="{StaticResource MenuBorder}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
